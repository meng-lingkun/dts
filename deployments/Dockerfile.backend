FROM golang:1.23-alpine AS build
WORKDIR /src
COPY backend/ ./backend/
WORKDIR /src/backend
RUN mkdir -p /out && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-server ./cmd/server && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-worker ./cmd/worker && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-cdc-bridge ./cmd/cdc-bridge && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-binlog-inspect ./cmd/binlog-inspect && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-mysql-cdc ./cmd/mysql-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-tidb-cdc ./cmd/tidb-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-postgres-cdc ./cmd/postgres-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-opengauss-cdc ./cmd/opengauss-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-gaussdb-cdc ./cmd/gaussdb-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-sqlserver-cdc ./cmd/sqlserver-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-oracle-cdc ./cmd/oracle-cdc
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-db2-cdc ./cmd/db2-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-dameng-cdc ./cmd/dameng-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-gbase-cdc ./cmd/gbase-cdc && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dts-gbase8s-cdc ./cmd/gbase8s-cdc
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/dtsctl ./cmd/dtsctl

FROM alpine:3.22
RUN apk add --no-cache ca-certificates zstd && \
    addgroup -S -g 10001 dts && \
    adduser -S -D -H -u 10001 -G dts dts && \
    mkdir -p /var/lib/dts/cdc-spool && \
    chown -R 10001:10001 /var/lib/dts
WORKDIR /app
COPY --from=build /out/ /usr/local/bin/
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/dts-server"]
