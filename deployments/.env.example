# Copy this file outside source control (for example `.env.local`), replace
# every empty value with an independently generated secret, then run:
# docker compose --env-file deployments/.env.local -f deployments/docker-compose.yml up --build
# Generate values with `openssl rand -base64 48` (run it separately for each
# secret). Keep `.env.local` outside source control.

QMIGRATION_METADATA_PASSWORD=
QMIGRATION_MASTER_KEY=
QMIGRATION_WORKER_TOKEN=
QMIGRATION_AUTH_SECRET=
QMIGRATION_BOOTSTRAP_ADMIN_USER=admin
QMIGRATION_BOOTSTRAP_ADMIN_PASSWORD=
QMIGRATION_CORS_ORIGIN=http://127.0.0.1:8088
QMIGRATION_WORKER_CONCURRENCY=4
QMIGRATION_WORKER_SHUTDOWN_GRACE_SECONDS=30
